{
  "name": "eduidec-landing-page",
  "version": "1.0.0",
  "description": "Landing page for EduIDE Cloud workspace management",
  "license": "EPL-2.0 OR GPL-2.0 WITH Classpath-exception-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EduIDE/EduIDE-Landing-Page.git"
  },
  "homepage": "https://github.com/EduIDE/EduIDE-Landing-Page#readme",
  "bugs": {
    "url": "https://github.com/EduIDE/EduIDE-Landing-Page/issues"
  },
  "keywords": [
    "theia",
    "cloud",
    "kubernetes",
    "landing-page",
    "react",
    "vite",
    "education"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@eclipse-theiacloud/common": "1.2.0",
    "@sentry/react": "^11.11.0",
    "keycloak-js": "26.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.185.1",
    "vanta": "^0.5.24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
